[Desktop Entry]
Version=1.0
Type=Application
Name=Sciscraper
GenericName=Scientific Markdown Editor
Comment=A scientific Markdown editor with reference management and RAG assistance
Exec=sciscraper %F
Icon=io.github.schmettow.Sciscraper
Terminal=false
Categories=Office;TextEditor;Utility;
Keywords=markdown;editor;science;reference;rag;
MimeType=text/plain;text/markdown;text/x-markdown;application/json;application/x-yaml;application/toml;text/x-toml;text/csv;text/tab-separated-values;
StartupNotify=true
StartupWMClass=sciscraper
